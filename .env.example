# Copy to .env for local development:  cp .env.example .env
# Never commit .env. In production these are Northflank secrets.

APP_ENV=local                 # local | test | production
LOG_LEVEL=INFO

# Local Postgres from docker compose. For Neon use the pooled URL, e.g.
# postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/agent?sslmode=require
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent

# --- Agent (phase 1) ------------------------------------------------------------
LLM_PROVIDER=groq              # groq | fake (fake = scripted demo, no API key needed)
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=                  # console.groq.com -> API Keys
GITHUB_TOKEN=                  # fine-grained PAT: test repo only, Contents + Pull requests read/write
ALLOWED_TEST_COMMANDS=pytest,python -m pytest
AGENT_MAX_FIX_ATTEMPTS=2
LLM_MIN_INTERVAL_SECONDS=1.0   # pacing between LLM calls (free tiers rate-limit)

# --- API & worker (phase 2) --------------------------------------------------------
# Each key belongs to a person; the requester of a job can't approve it.
# Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEYS=alice:change-me-alice-key-000000,bob:change-me-bob-key-0000000
ALLOWED_REPO_PREFIXES=https://github.com/<you>/,file://
RUN_WORKER_IN_API=false        # true on the free tier (one service runs both)

# --- Multi-agent + retrieval (phase 3) --------------------------------------------
SUPERVISOR_MODE=deterministic  # deterministic | llm (LLM proposes, policy decides; ADR 0008)
AGENT_MAX_LLM_CALLS=40         # per job, all agents; hitting it hands the job to a human
AGENT_MAX_REVIEW_ROUNDS=1
AGENT_MAX_REPLANS=1
RETRIEVAL_EMBEDDINGS=false     # true = hybrid BM25 + local embeddings (downloads ~100 MB model once)
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=.cache/models

# --- Governance (phase 4) ---------------------------------------------------------
# GitHub App: the agent pushes as <app>[bot] with 1-hour, one-repository tokens.
# Leave empty to use GITHUB_TOKEN instead (local development).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=        # PEM; on one line, write newlines as \n
APPROVERS=                     # e.g. bob,carol; empty = anyone except the requester
APPROVAL_TTL_HOURS=24
MAX_COST_PER_JOB_USD=0.50      # list-price LLM cost per job
DAILY_BUDGET_USD=5.00          # all jobs per UTC day; new jobs wait when reached
JOB_TIMEOUT_SECONDS=1200
# POLICY_FILE=path/to/policy.yaml   # default: governance/policies/default.yaml

# --- Web UI and sign-in (phase 5) -------------------------------------------------
# OpenID Connect (Zitadel). Leave empty to disable the UI; the JSON API keeps working.
OIDC_ISSUER=                   # e.g. https://<instance>.zitadel.cloud
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROJECT_ID=               # Zitadel project id: requests the project audience and its roles
# OIDC_ROLES_CLAIM=roles       # other providers: claim that holds the roles
SESSION_SECRET=                # openssl rand -base64 48; required in production
SESSION_MAX_AGE_HOURS=8

# --- Tracing and metrics (phase 6) ----------------------------------------------------
# Langfuse. Leave the keys empty to turn tracing off. Tests never trace.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com   # EU: https://cloud.langfuse.com (LANGFUSE_HOST also works)
LANGFUSE_SAMPLE_RATE=1.0
METRICS_READERS=               # users from API_KEYS allowed to read /metrics; empty = off

# --- Added in later phases ---------------------------------------------------------
# CEREBRAS_API_KEY=
# ANTHROPIC_API_KEY=
